* text=auto

*.rs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf

# Preserve the original bytes of SDK references and historical source snapshots.
/deps/netfilter/include/*.h -text
/legacy/cpp/**/*.cpp -text
/legacy/cpp/**/*.h -text

*.dll binary
*.sys binary
*.lib binary
*.png binary
*.zip binary
