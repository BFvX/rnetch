{
  "name": "rnetch-ui",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test electron/*.test.js tests/*.test.mjs",
    "build": "vite build",
    "electron": "electron .",
    "pack:portable": "powershell -ExecutionPolicy Bypass -File scripts/pack-release.ps1",
    "pack:installer": "powershell -ExecutionPolicy Bypass -File scripts/pack-release.ps1 -Format nsis",
    "pack:release": "powershell -ExecutionPolicy Bypass -File scripts/pack-release.ps1"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "dev.rnetch.control",
    "productName": "Rnetch Control",
    "asar": true,
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/rnetch-icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE-rnetch"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../build/package-resources/native",
        "to": "native"
      },
      {
        "from": "../build/package-resources/config.xml",
        "to": "config.xml"
      }
    ],
    "win": {
      "icon": "assets/rnetch.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
